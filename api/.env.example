# Copia este archivo como .env — NUNCA subas .env a git

NODE_ENV=development
PORT=3000

# Local
MONGO_URI=mongodb://localhost:27017/gimnasio

# Producción (MongoDB Atlas para Render)
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/gimnasio?retryWrites=true&w=majority

# Pool de conexiones (Regla 16 CLAUDE.md)
MONGO_MAX_POOL=10
MONGO_MIN_POOL=2
MONGO_MAX_IDLE_MS=30000

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Autenticación (JWT). Genera el secreto con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Correo para la recuperación de contraseña (opcional).
# Sin RESEND_API_KEY el código se imprime en la consola de la API.
# RESEND_API_KEY=
# MAIL_FROM=Músculo y Forma <onboarding@resend.dev>
